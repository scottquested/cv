{
	"name": "cv",
	"version": "1.0.0",
	"description": "Scott Quested's Curriculum Vitae",
	"main": "index.html",
	"scripts": {
		"dev": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
