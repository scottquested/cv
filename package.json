	"bugs": {
		"url": "https://github.com/scottquested/cv/issues"
	},
	"homepage": "https://github.com/scottquested/cv#readme",
	"devDependencies": {
		"@tailwindcss/cli": "^4.2.4",
		"puppeteer": "^24.43.0",
		"tailwindcss": "^4.2.4"
	}
}
